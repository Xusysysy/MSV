<?xml version="1.0" encoding="utf-8"?>
<!-- MSV 应用图标 · 前景层：上行双音符（纯黑白）
     · 去除五线谱线 → 更简洁；符头由强调蓝改为纯白 → 黑白方案
     · 符杠改为微弧路径（Q 二次曲线），比直线更有流动感与辨识度
     · 粗细统一 9；较上一版整体缩小约 10%（占幅 x 27.4-81.5 / y 32.5-75）
     · 各角点到圆心 ≤30.4，远小于自适应图标安全半径 36，各遮罩下不裁切 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- 微弧符杠 -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="9"
        android:strokeLineCap="round"
        android:pathData="M47,44Q62,40.5 77,37" />
    <!-- 左音符（较低）符杆 -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="9"
        android:strokeLineCap="round"
        android:pathData="M47,64L47,44" />
    <!-- 右音符（较高）符杆 -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="9"
        android:strokeLineCap="round"
        android:pathData="M77,56L77,37" />
    <!-- 左符头（纯白） -->
    <group
        android:pivotX="39"
        android:pivotY="66"
        android:rotation="-20">
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M27,66a12,8.5 0 1,0 24,0a12,8.5 0 1,0 -24,0z" />
    </group>
    <!-- 右符头（纯白） -->
    <group
        android:pivotX="69"
        android:pivotY="59"
        android:rotation="-20">
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M57,59a12,8.5 0 1,0 24,0a12,8.5 0 1,0 -24,0z" />
    </group>
</vector>
